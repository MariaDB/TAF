#
# PURPOSE:
#   This example file defines the configuration parameters for the optional
#   backend reporting subsystem. It is provided as a template only.
#
#   To enable backend reporting, copy this file to backend.conf and fill in
#   the required values. If backend.conf is missing, or if
#   enable_backend_reporting = 0, the backend reporting subsystem is
#   automatically disabled with no warnings.
#
#   No credentials are shipped with TAF. All values in this file must be
#   supplied by the organization deploying TAF.
#############################################################################

# Enable or disable backend reporting.
# Valid values: 0 or 1
enable_backend_reporting = 0

# Hostname or IP of the backend database server.
backend_db_host =

# Port number of the backend database server.
backend_db_port =

# Database name for backend reporting.
backend_db_name =

# Username for backend reporting.
backend_db_user =

# Password for backend reporting.
backend_db_pass =

# Optional: path to a client-side SSL CA file.
backend_db_ssl_ca =

# Optional: path to a client-side SSL certificate.
backend_db_ssl_cert =

# Optional: path to a client-side SSL key.
backend_db_ssl_key =

# Timeout (in seconds) for backend reporting operations.
backend_timeout = 5

# Maximum number of retries if backend is unreachable.
backend_retries = 1

#############################################################################
# End of backend.conf.example
#############################################################################