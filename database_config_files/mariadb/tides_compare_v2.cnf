[mysqld]
performance_schema=OFF
disable-log-bin
sync_binlog=0
general_log=OFF
slow_query_log=OFF

default_storage_engine=TidesDB
default_authentication_plugin=mysql_native_password
character_set_server=utf8mb4
collation_server=utf8mb4_general_ci
tls_version = TLSv1.2,TLSv1.3

max_connections=600
max_prepared_stmt_count=1000000
open_files_limit=65535
table_open_cache=4000
thread_cache_size=128

#transaction_isolation=REPEATABLE-READ
transaction_isolation=READ-COMMITTED

# sync
sync_master_info=0
sync_relay_log=0
sync_relay_log_info=0

aria_pagecache_buffer_size = 128M
aria_sort_buffer_size = 128M

tmp_table_size      = 32M
max_heap_table_size = 32M

plugin_maturity = unknown
plugin_load_add = ha_tidesdb.so

# TidesDB memory / cache
tidesdb_block_cache_size                       = 32G

tidesdb_unified_memtable                       = ON
tidesdb_unified_memtable_write_buffer_size     = 1G
tidesdb_unified_memtable_sync_mode             = NONE

tidesdb_default_sync_mode                      = NONE
tidesdb_default_compression                    = NONE

# background threads
tidesdb_flush_threads                          = 8
tidesdb_compaction_threads                     = 8

# SSTables / files
tidesdb_max_open_sstables                      = 0

# index / bloom
tidesdb_skip_unique_check                      = ON
tidesdb_default_bloom_fpr                      = 2

# locking
tidesdb_pessimistic_locking                    = ON

# logging
tidesdb_log_level                              = NONE

# compaction / tombstone
tidesdb_default_l0_queue_stall_threshold       = 20
tidesdb_default_l1_file_count_trigger          = 8
tidesdb_default_tombstone_density_trigger      = 5000
tidesdb_default_tombstone_density_min_entries  = 2048

# memory guard
tidesdb_max_memory_usage                       = 0

