[mysqld]
performance_schema=OFF
disable-log-bin
sync_binlog=0
general_log=OFF
slow_query_log=OFF

# Engine + auth + charset
default_storage_engine=RocksDB
default_authentication_plugin=mysql_native_password
character_set_server=utf8mb4
collation_server=utf8mb4_general_ci
tls_version = TLSv1.2,TLSv1.3

# Connections / caches
max_connections=600
max_prepared_stmt_count=1000000
open_files_limit=65535
table_open_cache=4000
thread_cache_size=128

# Transaction isolation (aligned with TidesDB / Alex)
transaction_isolation=READ-COMMITTED

# Replication / sync
sync_master_info=0
sync_relay_log=0
sync_relay_log_info=0

# Aria / temp
aria_pagecache_buffer_size = 128M
aria_sort_buffer_size = 128M

tmp_table_size      = 32M
max_heap_table_size = 32M

# Plugin load
plugin_maturity = gamma
plugin_load_add = ha_rocksdb.so

innodb_buffer_pool_size = 2G

###############################################################################
# ROCKSDB — ALIGNED WITH ALEX'S TEMPLATE + TIDESDB SETTINGS
###############################################################################

# Avoid table-cache mutex on every SST file access (FB critical recommendation)
rocksdb_max_open_files = -1

# Block cache (aligned with tidesdb_block_cache_size = 32G)
rocksdb_block_cache_size = 32G

# Larger block size (FB recommends 16KB)
rocksdb_block_size = 16384

# Shard table cache mutexes (reduces contention under high concurrency)
rocksdb_table_cache_numshardbits = 6

# Durability OFF for benchmarking (aligned with TidesDB sync_mode = NONE)
rocksdb_flush_log_at_trx_commit = 0
rocksdb_wal_recovery_mode       = 2

# WAL / sync behavior
rocksdb_max_total_wal_size      = 4G
rocksdb_bytes_per_sync          = 4M
rocksdb_wal_bytes_per_sync      = 4M

# Direct I/O OFF (Alex’s template uses buffered I/O for RocksDB)
rocksdb_use_direct_reads                       = 0
rocksdb_use_direct_io_for_flush_and_compaction = 0

# Background jobs / compactions (aligned with tidesdb_compaction_threads ≈ 8)
rocksdb_max_background_jobs      = 8
rocksdb_max_subcompactions       = 2
rocksdb_rate_limiter_bytes_per_sec = 0

# CF options — from Alex’s template, tuned for write-heavy workloads
rocksdb_default_cf_options = "write_buffer_size=64m;target_file_size_base=64m;max_bytes_for_level_base=1g;level0_file_num_compaction_trigger=4;level0_slowdown_writes_trigger=10;level0_stop_writes_trigger=20;max_write_buffer_number=4;block_based_table_factory={cache_index_and_filter_blocks=1;filter_policy=bloomfilter:10:false;whole_key_filtering=1};level_compaction_dynamic_level_bytes=true;optimize_filters_for_hits=true;compaction_pri=kMinOverlappingRatio"

# Sequential delete tuning (critical for DELETE workloads)
rocksdb_compaction_sequential_deletes_count_sd = 1
rocksdb_compaction_sequential_deletes          = 199999
rocksdb_compaction_sequential_deletes_window   = 200000

# Logging (minimal, aligned with tidesdb_log_level = NONE)
rocksdb_info_log_level = ERROR

[client]
default-character-set = utf8mb4

[mysqldump]
quick
max_allowed_packet = 64M

